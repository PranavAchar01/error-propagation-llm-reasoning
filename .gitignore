# Benchmark blobs are never committed — regenerate via `make data`, verify via checksums.
data/*
!data/README.md
!data/checksums.sha256

# Raw model outputs: large, regenerable from the API. Tables are regenerable from these.
results/raw/**/*.jsonl
results/raw/**/*.json

# Figures are regenerated by `make reproduce`
results/figures/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.env
.DS_Store

# Generated tables are regenerable from results/raw/ via `make reproduce`.
results/tables/*.md
results/tables/*.csv
!results/tables/.gitkeep
