# Credentials for the experiment harness. Analysis (`make reproduce`) needs none.
#
# OpenAI (default provider):
OPENAI_API_KEY=sk-...
# For an OAuth-fronted gateway, set the issued bearer above and the origin here:
# OPENAI_BASE_URL=https://your-gateway.example/v1

# Anthropic (optional second model family):
# ANTHROPIC_API_KEY=sk-ant-...
# Or, for an OAuth-secured gateway:
# ANTHROPIC_AUTH_TOKEN=...
# ANTHROPIC_BASE_URL=https://your-gateway.example
